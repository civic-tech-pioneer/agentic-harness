+        && let Out::Write(chunks) = out
+    {
+        let input: serde_json::Value = serde_json::from_slice(&req.body).map_err(other)?;
+        let session = input["prompt_cache_key"]
+            .as_str()
+            .ok_or_else(|| other("missing session"))?;
+        let first: u64 = loop {
+            if stop.load(Ordering::SeqCst) {
+                return Ok(());
+            }
+            if let Ok(text) = std::fs::read_to_string(&clock)
+                && let Ok(schedule) = serde_json::from_str::<serde_json::Value>(&text)
+            {
+                break schedule[session]
+                    .as_u64()
+                    .ok_or_else(|| other("session missing from schedule"))?;
+            }
+            thread::sleep(Duration::from_millis(10));
+        };
+        static NEXT: std::sync::OnceLock<Mutex<std::collections::HashMap<String, u64>>> =
+            std::sync::OnceLock::new();
+        let mut times = lock(NEXT.get_or_init(Default::default));
+        let next = times.entry(session.to_owned()).or_insert(first);
+        let due = *next;
+        *next += 1000;
+        drop(times);
+        let marker = format!("oa-{session}-{due}");
+        let mut chunks = chunks;
+        if chunks.is_empty() {
+            return Err(other("a paced write needs at least one chunk"));
+        }
+        chunks.insert(
+            1,
+            event(serde_json::json!({
+                "type": "response.output_text.delta", "item_id": "msg_1",
+                "output_index": 0, "content_index": 0, "delta": marker
+            })),
+        );
+        // Persist the delta's marker as an ordinary assistant message, before completion.
+        chunks.insert(
+            chunks.len() - 1,
+            event(serde_json::json!({
+                "type": "response.output_item.done",
+                "item": {
+                    "type": "message", "id": "msg_1", "role": "assistant",
+                    "content": [{ "type": "output_text", "text": marker }]
+                }
+            })),
+        );
+        let mut remaining = due.saturating_sub(epoch_nanos() / 1_000_000);
+        while remaining > 0 && !stop.load(Ordering::SeqCst) {
+            thread::sleep(Duration::from_millis(remaining.min(25)));
+            remaining = due.saturating_sub(epoch_nanos() / 1_000_000);
+        }
+        out = Out::Paced(marker, chunks);
+    }
